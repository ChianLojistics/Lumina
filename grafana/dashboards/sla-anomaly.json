{
  "uid": "lumina-sla-anomaly",
  "title": "SLA & Anomaly Detection",
  "tags": ["lumina", "sla", "anomaly"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "SLA Compliance Ratio (30-day rolling)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.995 },
              { "color": "green", "value": 0.999 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sla_compliance_ratio",
          "legendFormat": "{{sla}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Budget Remaining",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sla_error_budget_remaining_ratio",
          "legendFormat": "{{sla}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "SLA Violations (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(sla_violations_total[30d])) by (sla)",
          "legendFormat": "{{sla}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "SLA Compliance Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.98,
          "max": 1,
          "custom": { "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sla_compliance_ratio",
          "legendFormat": "{{sla}} ({{window}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Error Budget Burn Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 - sla_error_budget_remaining_ratio",
          "legendFormat": "budget consumed — {{sla}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "SLA Violation Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(sla_violations_total[1h])) by (sla, type)",
          "legendFormat": "{{sla}} / {{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Anomaly Scores",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "anomaly_score",
          "legendFormat": "{{metric}} / {{dimension}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Anomalies Detected",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(anomalies_detected_total[5m])) by (metric, severity)",
          "legendFormat": "{{metric}} ({{severity}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Cumulative Anomalies by Severity",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(increase(anomalies_detected_total[24h])) by (severity)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ]
    }
  ]
}
