{
  "uid": "lumina-synthetic-monitoring",
  "title": "Synthetic Monitoring",
  "tags": ["lumina", "synthetic", "uptime"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Probe Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["last"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "synthetic_probe_success",
          "legendFormat": "{{probe}} ({{endpoint}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Probe Uptime % (last 24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.99 },
              { "color": "green", "value": 0.999 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(synthetic_probe_total{status=\"success\"}[24h])) by (probe) / sum(increase(synthetic_probe_total[24h])) by (probe)",
          "legendFormat": "{{probe}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Probe Response Time p95 (last 5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(synthetic_probe_duration_seconds_bucket[5m])) by (le, probe))",
          "legendFormat": "{{probe}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Probe Success/Failure Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "synthetic_probe_success",
          "legendFormat": "{{probe}} — {{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Probe Response Time (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(synthetic_probe_duration_seconds_bucket[5m])) by (le, probe, endpoint))",
          "legendFormat": "p50 {{probe}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(synthetic_probe_duration_seconds_bucket[5m])) by (le, probe, endpoint))",
          "legendFormat": "p95 {{probe}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(synthetic_probe_duration_seconds_bucket[5m])) by (le, probe, endpoint))",
          "legendFormat": "p99 {{probe}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "title": "Probe Execution Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(synthetic_probe_total[5m])) by (probe, status)",
          "legendFormat": "{{probe}} — {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Probe Failures (last 24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(increase(synthetic_probe_total{status!=\"success\"}[1h])) by (probe, status)",
          "legendFormat": "{{probe}} — {{status}}",
          "refId": "A"
        }
      ]
    }
  ]
}
