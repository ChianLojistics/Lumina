{
  "uid": "lumina-blockchain-performance",
  "title": "Blockchain Performance",
  "tags": ["lumina", "blockchain"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Blockchain Tx Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(blockchain_tx_total[5m])) by (network, operation)",
          "legendFormat": "{{network}} / {{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Blockchain Tx Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(blockchain_tx_total{status=\"error\"}[5m])) by (network) / sum(rate(blockchain_tx_total[5m])) by (network)",
          "legendFormat": "{{network}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tx Confirmation Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(blockchain_tx_duration_seconds_bucket[10m])) by (le, network, operation))",
          "legendFormat": "p50 {{network}}/{{operation}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(blockchain_tx_duration_seconds_bucket[10m])) by (le, network, operation))",
          "legendFormat": "p95 {{network}}/{{operation}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(blockchain_tx_duration_seconds_bucket[10m])) by (le, network, operation))",
          "legendFormat": "p99 {{network}}/{{operation}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total Transactions by Status",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(increase(blockchain_tx_total[24h])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Transactions by Network (24h)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(increase(blockchain_tx_total[24h])) by (network)",
          "legendFormat": "{{network}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Transaction Throughput by Operation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(blockchain_tx_total[5m])) by (operation)",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ]
    }
  ]
}
