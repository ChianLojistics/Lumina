FEE_MANAGER_CONTRACT_ID=

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=lumina
DATABASE_PASSWORD=lumina_password
DATABASE_NAME=lumina

# Backend
PORT=4000
NODE_ENV=development

# Logging
LOG_LEVEL=debug
LOG_DIR=logs

# Error Tracking (Sentry)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

