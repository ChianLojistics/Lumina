# Stellar
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_TREASURY_ADDRESS=
# Timeout (ms) for a single Stellar RPC query before it's treated as failed
TRANSACTION_QUERY_TIMEOUT=10000
# Max attempts (with exponential backoff) for a Stellar RPC query before giving up
MAX_RETRY_ATTEMPTS=3

# Contracts
PAYMENT_REGISTRY_CONTRACT_ID=
MERCHANT_VAULT_CONTRACT_ID=
ESCROW_CONTRACT_ID=
PAYMENT_SPLIT_CONTRACT_ID=
SUBSCRIPTION_CONTRACT_ID=
FEE_MANAGER_CONTRACT_ID=

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=lumina
DATABASE_PASSWORD=lumina_password
DATABASE_NAME=lumina

# Backend
PORT=4000
NODE_ENV=development

# Logging
LOG_LEVEL=debug
LOG_DIR=logs

# Error Tracking (Sentry)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_EXPIRY_SECONDS=604800
BCRYPT_SALT_ROUNDS=10
TWO_FACTOR_APP_NAME=Lumina
FRONTEND_URL=http://localhost:3000
API_KEY_SALT=

# Exchange / Conversion
EXCHANGE_API_KEY=
PRICE_ORACLE_URL=
CONVERSION_FEE_BPS=50
PRICE_CACHE_TTL_SECONDS=60
COINGECKO_API_URL=https://api.coingecko.com/api/v3
BINANCE_API_URL=https://api.binance.com/api/v3
CHAINLINK_RPC_URL=
CHAINLINK_BTC_USD_FEED=
CHAINLINK_ETH_USD_FEED=
CHAINLINK_XLM_USD_FEED=
CHAINLINK_USDT_USD_FEED=
CHAINLINK_USDC_USD_FEED=

# Notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@lumina.dev

# Ramp Service - Payment Providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ACCOUNT_ID=
MOONPAY_API_KEY=
MOONPAY_WEBHOOK_SECRET=
BANXA_API_KEY=
BANXA_WEBHOOK_SECRET=

# Monitoring (Grafana) - Alertmanager reads its secrets from
# alertmanager/secrets/*, not from this file; see alertmanager/README.md.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Multi-Layer Caching
# L1 Cache (In-Memory)
L1_CACHE_MAX_SIZE=1000
L1_CACHE_DEFAULT_TTL=60

# L2 Cache (Redis)
L2_CACHE_DEFAULT_TTL=3600
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=localhost:6379

# L3 Cache (CDN)
L3_CACHE_ENABLED=false
L3_CACHE_PROVIDER=custom
L3_CACHE_DEFAULT_TTL=86400

# Cache Invalidation
CACHE_KEY_PREFIX=lumina
CACHE_KEY_VERSION=v1

# Cache Warmup
CACHE_WARMUP_ENABLED=true
CACHE_WARMUP_PATTERNS=merchant:config:*,payment:methods:*,exchange:rates:*
CACHE_WARMUP_SCHEDULE=0 * * * *
CACHE_WARMUP_MAX_CONCURRENT=10

# Predictive Cache
PREDICTIVE_CACHE_ENABLED=true
PREDICTIVE_CACHE_ANALYSIS_INTERVAL=300000
PREDICTIVE_CACHE_PRELOAD_THRESHOLD=60000

# CDN Providers (if L3 enabled)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_KEY=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
CUSTOM_CDN_INVALIDATION_URL=
